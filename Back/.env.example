SUPABASE_URL=https://wggybysntrpnkfaefvxj.supabase.co
SUPABASE_PUBLISHABLE_KEY=coloca_aqui_la_clave_publicable
# Activar solo después de aplicar y verificar Supabase/registro_usuarios.sql.
REGISTRO_HABILITADO=false
# Activar después de aprobar, aplicar y verificar Supabase/administracion_cuentas.sql.
ADMINISTRACION_HABILITADA=false
# Origen del frontend para los enlaces de confirmación y recuperación; agregar su retorno en Supabase Auth.
FRONTEND_URL=http://localhost:5173

# Solo en backend: clave secreta para invitaciones, nunca publicar.
SUPABASE_SECRET_KEY=coloca_aqui_la_clave_secreta
# Activar tras comprobar Supabase/alta_asistida_cuentas.sql y configurar la clave.
ALTA_ASISTIDA_HABILITADA=false

# Clave de API.SH para noticias culturales; solo en el servidor.
APISH_KEY=coloca_aqui_la_clave_de_api_sh

# Asistente del portal. Usa el identificador que muestra GET /v1/models en LM Studio.
ASISTENTE_LM_URL=http://127.0.0.1:1234/v1
# Déjalo vacío para usar la recuperación textual de fuentes aprobadas.
ASISTENTE_LM_MODELO=google/gemma-4-e4b
# Token opcional si activaste la autenticación en el servidor del modelo.
ASISTENTE_LM_TOKEN=

# Correo transaccional para cambios y cancelaciones de actividades.
BREVO_SMTP_USER=tu_usuario_smtp
BREVO_SMTP_KEY=tu_clave_smtp
BREVO_SENDER_EMAIL=tu_correo_verificado
